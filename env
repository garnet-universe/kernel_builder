#!/bin/bash
#
# Garnet GKI 5.10 Kernel Builder Config

export maindir="$(pwd)"
export outside="${maindir}/.."

#

export ARCH="arm64"
export SUBARCH="arm64"
export KBUILD_BUILD_USER="garnet-universe"
export KBUILD_BUILD_HOST="github-actions"

# Multi-Defconfig for GKI 5.10 (SM7435)
# Order matters: later configs override earlier ones
export DEFCONFIGS="gki_defconfig vendor/garnet_GKI.config"
export defconfig="garnet_GKI.config"

if [[ -z "$zipper_repo" ]]; then
  export zipper_repo="https://github.com/garnet-universe/AnyKernel3"
fi
if [[ -z "$zipper_branch" ]]; then
  export zipper_branch="garnet"
fi

# Garnet GKI produces uncompressed Image
export out_image="${maindir}/out/arch/${ARCH}/boot/Image"

export zipper="${outside}/zipper"

#

export defconfig_file="${maindir}/arch/${ARCH}/configs/gki_defconfig"

export kernel_head="$(git log --pretty=format:'%h' -1)"
export kernel_ver="$(grep -m1 '^VERSION' Makefile | cut -d= -f2 | tr -d ' ').$(grep -m1 '^PATCHLEVEL' Makefile | cut -d= -f2 | tr -d ' ').$(grep -m1 '^SUBLEVEL' Makefile | cut -d= -f2 | tr -d ' ')"
# kernel_name: read from CONFIG_LOCALVERSION in defconfig (empty if not set)
export kernel_name_raw=$(grep 'CONFIG_LOCALVERSION=' "${defconfig_file}" 2>/dev/null | sed 's/CONFIG_LOCALVERSION=//g' | sed 's/"//g')
if [[ "$kernel_name_raw" == *"#"* ]]; then
  export kernel_name="(HASTAG)$(echo "$kernel_name_raw" | sed 's/^[-#]*//')"
else
  export kernel_name="$(echo "$kernel_name_raw" | sed 's/^[-#]*//')"
fi
export TIME=$(date +"%y%m%d-%H%M")

export zip_name="${maindir}/${kernel_name}${SUFFIX:-garnet}-${TIME}-${kernel_head}.zip"